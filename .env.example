# Anthropic API Key (for AI-powered analysis - Phase 3)
ANTHROPIC_API_KEY=your_key_here

# ── Python Trading Engine ──────────────────────────────────────────────────────

# Twilio WhatsApp notifications
# Sign up at https://www.twilio.com/try-twilio
# Enable WhatsApp Sandbox: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your personal WhatsApp number (must be registered in the Twilio sandbox)
WHATSAPP_TO=whatsapp:+56912345678

# OANDA API (optional - higher quality forex data)
OANDA_API_KEY=your_oanda_api_key
OANDA_ACCOUNT_ID=your_oanda_account_id

# Flask API server
FLASK_PORT=5001
FLASK_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# Next.js → Python bridge
FLASK_API_URL=http://localhost:5001

# Strategy parameters (optional - these are the defaults)
RSI_OVERSOLD=35
RSI_OVERBOUGHT=65
BB_PERIOD=20
BB_STD_DEV=2.0
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=1.5
ATR_TARGET_MULTIPLIER=3.0
RISK_PER_TRADE_PCT=1.0
ACCOUNT_BALANCE=10000

# Signal scheduler
SIGNAL_CHECK_INTERVAL_MINUTES=60
HISTORICAL_DAYS=90
